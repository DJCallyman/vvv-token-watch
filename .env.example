# ============================================================================
# VVV Token Watch - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# Run: cp .env.example .env (macOS/Linux)
# ============================================================================

# ----------------------------------------------------------------------------
# VENICE AI API KEYS - Get from: https://venice.ai/settings/api
# ----------------------------------------------------------------------------

# REQUIRED: Venice Admin API Key (for billing/usage monitoring)
# IMPORTANT: Must be an "Admin" key type, NOT "Inference Only"
# Regular inference keys will return 401 Unauthorized on /billing/usage endpoint
VENICE_ADMIN_KEY=

# Venice model ID used by the read-only assistant.
# Verify availability in the Models view when changing this value.
ASSISTANT_MODEL=venice-uncensored-1-2

# OPTIONAL: Venice Inference API Key
# Used for public endpoints like /models to avoid exposing the admin key
# IMPORTANT: Use a separate inference-only key here, NOT the same key as
# VENICE_ADMIN_KEY above.
VENICE_API_KEY=

# ----------------------------------------------------------------------------
# APP AUTHENTICATION - REQUIRED
# ----------------------------------------------------------------------------

# Shared password protecting the web UI and API. The app refuses to start
# without this set (unless ALLOW_INSECURE_NO_AUTH=true).
# Generate one with: openssl rand -hex 24
APP_PASSWORD=

# Explicit opt-in to run without authentication. NOT recommended outside a
# fully isolated, trusted network.
ALLOW_INSECURE_NO_AUTH=false

# ----------------------------------------------------------------------------
# DOCKER POSTGRESQL - REQUIRED FOR PRODUCTION COMPOSE
# ----------------------------------------------------------------------------

# Password used by the PostgreSQL container and the default DATABASE_URL in
# docker/docker-compose.yml. Local development via ./dev.sh uses its own
# development database settings and does not read this variable.
DB_PASSWORD=

# ----------------------------------------------------------------------------
# VENICE API PAGINATION SETTINGS (Advanced)
# ----------------------------------------------------------------------------

# Number of results to fetch per API request page
# Default: 500 (max supported by Venice API)
API_PAGE_SIZE=500

# Maximum number of pages to fetch before stopping
# Default: 20 (prevents runaway queries)
API_MAX_PAGES=20

# ----------------------------------------------------------------------------
# VENICE BILLING DEFAULTS
# ----------------------------------------------------------------------------

# Default daily DIEM spending limit for API keys (fallback value)
# Used when API key doesn't have explicit limits configured
DEFAULT_DAILY_DIEM_LIMIT=100.0

# Default daily USD spending limit for API keys (fallback value)
DEFAULT_DAILY_USD_LIMIT=25.0

# Venice billing epoch length, used to compute epoch_start from nextEpochBegins
# (epoch_start = nextEpochBegins - EPOCH_LENGTH_HOURS).
# Default: 24 (Venice's current 24h rolling window)
EPOCH_LENGTH_HOURS=24

# ----------------------------------------------------------------------------
# PRICE AND HOLDINGS CONFIGURATION
# ----------------------------------------------------------------------------

# Live prices come from VeniceStats. The following legacy settings remain
# accepted for compatibility with existing .env files; they do not configure
# the live price source.
COINGECKO_API_KEY=
COINGECKO_TOKEN_ID=venice-token
COINGECKO_CURRENCIES=usd,aud

# Legacy variable name used for manual VVV holdings; default: 2750
COINGECKO_HOLDING_AMOUNT=2750

# Legacy token identifier; retained for existing configuration files.
DIEM_TOKEN_ID=diem

# Your DIEM token holdings (for portfolio value calculation)
# Default: 0
DIEM_HOLDING_AMOUNT=0

# ----------------------------------------------------------------------------
# SNAPSHOT HISTORY
# ----------------------------------------------------------------------------

# Retention (days) for usage_snapshots and price_snapshots rows. Older rows
# are purged on each snapshot write and at startup.
# Default: 90
SNAPSHOT_RETENTION_DAYS=90

# ----------------------------------------------------------------------------
# APPLICATION SETTINGS
# ----------------------------------------------------------------------------

# Backend log level: INFO or DEBUG
LOG_LEVEL=INFO

# Set to true to echo all SQL statements (can log sensitive data)
SQL_ECHO=false

# Local data directory
DATA_DIR=./data

# Local log file path
LOG_FILE_PATH=./data/logs/app.log

# ----------------------------------------------------------------------------
# EXTERNAL NOTIFICATIONS (Slice 2.4)
# ----------------------------------------------------------------------------

# Outbound alert delivery. Discord, Slack, Telegram, generic HTTPS webhooks,
# and browser push work without extra configuration. Email needs the SMTP
# values below. Browser push needs a VAPID key pair; without it the provider
# is reported as unavailable (never as a silent failure).
# Generate VAPID keys with: npx web-push generate-vapid-keys
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ----------------------------------------------------------------------------
# AI FEATURE MODELS (Phase 3)
# ----------------------------------------------------------------------------

# Embeddings model for semantic news search and document RAG.
EMBEDDING_MODEL=text-embedding-bge-m3
# Text-to-speech model and voice for alerts and daily briefings.
TTS_MODEL=tts-kokoro
TTS_VOICE=af_sky
# Video model for asynchronous market recap generation.
VIDEO_MODEL=wan-2.5-preview-text-to-video

# ----------------------------------------------------------------------------
# FRONTEND (Next.js) COOKIES
# ----------------------------------------------------------------------------

# When 'true', the session cookie is set with the Secure attribute. This is
# the default in production builds. Override to 'false' for plain-HTTP
# deployments (LAN / Unraid without a TLS-terminating reverse proxy) — the
# browser will refuse to store a Secure cookie over HTTP otherwise.
# Frontend (Next.js) reads this; not picked up by FastAPI.
SESSION_SECURE_COOKIE=true
